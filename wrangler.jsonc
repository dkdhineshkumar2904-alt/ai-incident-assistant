{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-incident-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INCIDENT_DO",
        "class_name": "IncidentDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["IncidentDurableObject"]
    }
  ],
  "workflows": [
    {
      "name": "incident-analysis-workflow",
      "binding": "INCIDENT_WORKFLOW",
      "class_name": "IncidentAnalysisWorkflow"
    }
  ],
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  }
}
