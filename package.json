{
  "name": "ai-incident-assistant",
  "version": "1.0.0",
  "description": "Production-grade AI Incident Assistant powered by Cloudflare Workers, Workers AI, Durable Objects, and Workflows",
  "private": true,
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:frontend && wrangler deploy --dry-run --outdir dist/worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm --prefix frontend run typecheck",
    "deploy": "npm run build:frontend && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "workers-ai",
    "durable-objects",
    "workflows",
    "llama-3.3",
    "incident-management"
  ],
  "author": "Dhineshkumar Selladurai",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.135.0"
  }
}
